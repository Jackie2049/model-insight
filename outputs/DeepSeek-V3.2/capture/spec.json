    },
    {
      "module": "outputs/DeepSeek-V3.2/capture/shims/kernel.py",
      "class": "Fp8IndexShim",
      "mount_name": "fp8_index",
      "rebind": [{ "module": "model", "attr": "fp8_index" }]
    }
  ],
