{
  "spec_version": "1.0",
  "model": {
    "name": "DeepSeek-V3.2（缩水实例化：4 层 / 8 头 / 32 专家，分支维度保真）",
    "dir": "inputs/DeepSeek-V3.2",
    "entry": {
      "sys_path": [
        "outputs/DeepSeek-V3.2/capture/shims",
        "inputs/DeepSeek-V3.2/inference"
      ],
      "module": "model",
      "class": "Transformer",
      "constructor_args": {}
    },
    "default_dtype": "bfloat16",
